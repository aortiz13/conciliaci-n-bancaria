# ---------------------------------------------------------------------------
# Supabase (proyecto en región UE — RGPD)
# ---------------------------------------------------------------------------
# URL pública del proyecto Supabase (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable / anon (segura para el navegador, sujeta a RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role — SOLO backend/serverless. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# URL del proyecto para el servicio Python (mismo valor que NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=

# ---------------------------------------------------------------------------
# Extracción LLM (Gemini 2.5 vía Vertex AI, región UE)
# ---------------------------------------------------------------------------
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Canal Telegram (grammY)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Secreto para validar el webhook entrante de Telegram
TELEGRAM_WEBHOOK_SECRET=
# Tenant por defecto para despliegues de bot por tenant (fallback de ingesta)
DEFAULT_TENANT_ID=

# ---------------------------------------------------------------------------
# Email inbound (SendGrid Inbound Parse)
# ---------------------------------------------------------------------------
SENDGRID_INBOUND_SECRET=
# Dominio base para los alias por tenant (p.ej. facturas.midominio.com)
INBOUND_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Orquestación async (Inngest)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# URL del servicio de extracción Python (por defecto: <APP_URL>/api/extract)
EXTRACTION_SERVICE_URL=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
